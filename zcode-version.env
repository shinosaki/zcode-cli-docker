# zcode-cli-container version pins — single source of truth
#
# This file is the ONLY place where build inputs are pinned.
# - scripts/verify-pin.mjs is the STRICT canonical parser of this file (it
#   rejects duplicate keys, unknown keys, CR characters, missing trailing
#   newline). It runs BEFORE any value is loaded into the build environment,
#   so a malformed or manipulated file fails the build instead of being used.
# - The update workflow opens PRs that change exactly this file.
#
# SECURITY NOTE: the upstream repository URL is deliberately NOT in this file.
# A version-bump PR may change WHAT we build, never WHERE it comes from. The
# URL is hard-coded in scripts/verify-pin.mjs, scripts/check-upstream-update.mjs
# and .github/workflows/build-and-publish.yml.
#
# Lines: KEY=VALUE. Lines starting with # are comments. No quoting, no spaces.

# --- Upstream zcode CLI ------------------------------------------------------
# git tag to build from (annotated or lightweight, must match ^v<semver>$)
ZCODE_TAG=v3.17.1
# zcode version without the leading "v" (image tag + dist version)
ZCODE_VERSION=3.17.1
# Commit the tag must resolve to. CI verifies tag->commit equality twice:
# once on the runner (scripts/verify-pin.mjs) and once inside the builder
# (git rev-parse HEAD). Tags are mutable; the commit SHA is the real pin.
ZCODE_COMMIT=a60ba6a7e5a06742270ca605f5d2cc2766afa7e1

# --- Base image --------------------------------------------------------------
# Generic Node.js / Debian image, suitable as an interactive coding-agent base.
# NOTE: the digest is authoritative at pull time (Docker ignores the tag when
# a digest is present). NODE_IMAGE_TAG exists for humans and for the update
# detector, which bumps tag+digest together when a new 24.14.x patch appears.
# The digest is the MULTI-ARCH index digest (resolves per platform at pull).
NODE_IMAGE=docker.io/library/node
NODE_IMAGE_TAG=24.14.1-bookworm-slim
NODE_IMAGE_DIGEST=sha256:b506e7321f176aae77317f99d67a24b272c1f09f1d10f1761f2773447d8da26c

# --- Toolchain ---------------------------------------------------------------
# pnpm version, matching upstream mise.toml. Installed from registry.npmjs.org
# only, with the tarball integrity pinned below (canary against registry drift).
PNPM_VERSION=10.33.2
PNPM_INTEGRITY=sha512-qQ+vb+6rca1sblf5Tg/hoS9dzCLNdU20CulZPraj4LaxLjVAIYuzeuCDQEsfLObbKkEh6XmCm0r/lLmfSdoc+A==

# --- Supply-chain policy -----------------------------------------------------
# Registry used for upstream project dependencies. Lockfile integrity is the
# primary control (pnpm verifies every tarball against the repo's committed
# pnpm-lock.yaml); this registry is defense-in-depth (it filters known-malicious
# package versions at the metadata level and 302-redirects tarballs to npmjs,
# serving byte-identical integrity values). Switch back to
# https://registry.npmjs.org/ here if the proxy has an outage.
NPM_REGISTRY=https://npm.flatt.tech/
# minimumReleaseAge (pnpm setting, unit: MINUTES — 10080 = 7 days) applied at
# pnpm resolution time as defense-in-depth for any re-resolution; a frozen
# lockfile normally performs none. The primary age gate for upstream tags is
# MINIMUM_RELEASE_AGE_DAYS below.
MINIMUM_RELEASE_AGE_MINUTES=10080
# An upstream tag is only eligible for the update PR after its commit is at
# least this many days old (committer date; spoofable by whoever controls
# upstream — see SECURITY.md "Residual risks").
MINIMUM_RELEASE_AGE_DAYS=7
